{
  "name": "Estampido · Stickers de WhatsApp con sonido",
  "short_name": "Estampido",
  "description": "Convierte tus videos, GIFs e imágenes en stickers de WhatsApp que suenan al tocarlos.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "categories": [
    "entertainment",
    "multimedia",
    "social"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "video/*",
            "image/*",
            "audio/*",
            ".mp4",
            ".mov",
            ".webm",
            ".gif",
            ".webp",
            ".png",
            ".jpg",
            ".jpeg",
            ".mp3",
            ".m4a",
            ".ogg",
            ".opus",
            ".wav"
          ]
        }
      ]
    }
  }
}
