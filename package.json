{
  "name": "sticker-video-audio",
  "version": "0.1.0",
  "description": "Video → WhatsApp animated WebP sticker with audio (sound sticker)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sva": "./dist/adapters/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-deps": "tsx scripts/check-deps.ts",
    "dev:api": "tsx watch src/adapters/http/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "bot": "tsx --env-file-if-exists=.env src/adapters/bot/index.ts",
    "bot:capture": "tsx --env-file-if-exists=.env src/adapters/bot/index.ts --capture",
    "cli": "tsx src/adapters/cli/index.ts",
    "test:e2e": "npm --prefix web run build && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "baileys": "^7.0.0-rc14",
    "commander": "^15.1.0",
    "hono": "^4.13.21",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^24.19.2",
    "@types/qrcode-terminal": "^0.12.2",
    "concurrently": "^10.0.7",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
