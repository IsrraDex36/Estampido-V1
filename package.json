{
  "name": "sticker-video-audio",
  "version": "0.1.0",
  "description": "Video → WhatsApp animated WebP sticker with audio (sound sticker)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sva": "./dist/adapters/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/adapters/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check-deps": "tsx scripts/check-deps.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
