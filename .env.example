# Optional: override binaries (default: ffmpeg-full keg if present, else PATH)
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# Bot (npm run bot loads .env automatically)
# SVA_ALLOWED=525512345678,5215512345678   # numbers allowed to use /saudio (country code, no +)
# SVA_PACK=Mis stickers
# SVA_AUTHOR=                               # default: sender's WhatsApp name
# SVA_FIT=crop                              # default /saudio framing: crop | pad
# SVA_SEND_MODE=native                      # native | fallback | both
# SVA_RATE_PER_MIN=6                        # max /saudio per sender per minute (0 = unlimited)
# SVA_SELF_CHAT_ONLY=1                      # bot on your own number: only react in your chat with yourself
# SVA_DEBUG=1                               # bot: log every received message and why it is handled/ignored

# Production (npm run start / start:public)
# SVA_MODE=production                       # API serves web/dist + /api on one port (set by npm run start)
# SVA_TRUST_PROXY=1                         # real client IP from CF-Connecting-IP (default on in production)
# SVA_OWNER_SELF_SEND=1                    # unlinked browser → bot owner's own chat (default ON locally, OFF in production)
# SVA_PUBLISH_REQUIRES_LINK=1               # publishing needs a linked WhatsApp (default on in production)
# SVA_COMMUNITY_MAX_MB=2048                 # storage cap for published stickers
# SVA_DATA_DIR=.data                        # links (per bot number) live in $SVA_DATA_DIR/links/
